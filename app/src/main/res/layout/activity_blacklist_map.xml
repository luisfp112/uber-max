<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_secondary">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚫 Zonas Excluidas"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/tv_zone_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 zonas"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Instrucciones -->
    <TextView
        android:id="@+id/tv_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca el mapa para agregar puntos"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="8dp"
        android:background="@color/bg_tertiary" />

    <!-- Mapa OpenStreetMap (OSMDroid) — gratuito, sin API key -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Extraction progress bar -->
    <LinearLayout
        android:id="@+id/extraction_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/bg_secondary"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_extraction_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extrayendo direcciones..."
            android:textColor="@color/warning"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/bg_secondary"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_zone"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Cerrar zona"
            android:textColor="@color/bg_primary"
            android:backgroundTint="@color/profit_negative"
            android:textSize="13sp"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_undo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:text="↩ Deshacer"
            android:textColor="@color/text_secondary"
            android:strokeColor="@color/bg_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="🗑 Limpiar"
            android:textColor="@color/text_secondary"
            android:strokeColor="@color/bg_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Zones list (collapsible) -->
    <LinearLayout
        android:id="@+id/zones_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxHeight="200dp"
        android:background="@color/bg_secondary"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zonas activas:"
            android:textColor="@color/profit_negative"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/zones_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
