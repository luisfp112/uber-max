<?xml version="1.0" encoding="utf-8"?>
<!-- HUD Overlay Layout — Ventana flotante con métricas y destino -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:maxWidth="340dp"
    android:orientation="vertical"
    android:background="@drawable/hud_background"
    android:padding="12dp"
    android:elevation="8dp">

    <!-- Drag Handle + Header -->
    <LinearLayout
        android:id="@+id/hud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/hud_drag_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/drag_handle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="UberMax"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_decision"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ ESPERANDO"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded Content -->
    <LinearLayout
        android:id="@+id/expanded_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_net_profit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 ---"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Destino del pasajero -->
        <TextView
            android:id="@+id/tv_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Esperando oferta..."
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_distances"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Esperando oferta..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_fuel_cost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/warning"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_profit_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/info"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <!-- Warnings / Filtros fallidos -->
        <TextView
            android:id="@+id/tv_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/profit_negative"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Recomendación IA -->
        <TextView
            android:id="@+id/tv_ai_recommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
