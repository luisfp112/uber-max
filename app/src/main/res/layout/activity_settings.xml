<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary"
                android:contentDescription="Volver" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtros Maxymo"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- ═══ VEHÍCULO ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 Vehículo"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del vehículo (opcional)"
            android:layout_marginBottom="6dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_vehicle_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Costo manual por km (0 = automático)"
            android:layout_marginBottom="6dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_manual_cost_per_km"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Velocidad promedio (km/h)"
            android:layout_marginBottom="16dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_avg_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══ RECOGIDA ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Recogida"
            android:textColor="@color/secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_pickup_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Máx recogida (0 = sin límite)"
            android:layout_marginBottom="6dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_pickup_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/rg_pickup_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp">
            <RadioButton
                android:id="@+id/rb_pickup_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minutos"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="24dp" />
            <RadioButton
                android:id="@+id/rb_pickup_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Km"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- ═══ VIAJE ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛣️ Viaje"
            android:textColor="@color/secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_trip_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Máx viaje (0 = sin límite)"
            android:layout_marginBottom="6dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_trip_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/rg_trip_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp">
            <RadioButton
                android:id="@+id/rb_trip_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minutos"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="24dp" />
            <RadioButton
                android:id="@+id/rb_trip_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Km"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- ═══ PASAJERO ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Pasajero"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_min_passenger_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rating mínimo (0 = desactivado)"
            android:layout_marginBottom="16dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_min_passenger_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══ RENTABILIDAD ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰 Rentabilidad"
            android:textColor="@color/profit_positive"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="La ganancia neta por kilómetro decide si un viaje es rentable. El monto de la tarjeta de Uber ya viene descontada la comisión de la plataforma."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_min_profit_per_km"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_min_profit_per_km"
            android:layout_marginBottom="16dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_min_profit_per_km"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══ TOGGLES ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_behavior_title"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_accept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-aceptar ofertas aprobadas"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_human_taps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_human_taps"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_voice_announce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_voice_announce"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <!-- ═══ GEOLOCALIZACIÓN (PERÍMETRO URBANO) ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_geo_title"
            android:textColor="@color/info"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_geo_summary"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_geo_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_geo_check"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_geo_api_key"
            android:layout_marginBottom="16dp"
            android:textColorHint="@color/text_tertiary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_geo_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:autofillHints="no" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_onboarding"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/onboarding_title"
            android:textAllCaps="false"
            android:backgroundTint="@color/bg_tertiary"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_config"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/export_config"
            android:textAllCaps="false"
            android:backgroundTint="@color/bg_tertiary"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_config"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/import_config"
            android:textAllCaps="false"
            android:backgroundTint="@color/bg_tertiary"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <!-- SAVE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>